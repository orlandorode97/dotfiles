{
  "theme": {
    "mode": "dark",
    "dark": "Rosé Pine Moon",
    "light": "Rosé Pine Dawn",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato",
  },
  "buffer_font_family": "Monaspace Neon",
  "buffer_font_size": 14.0,
  "buffer_font_features": {
    "calt": true,
    "liga": true,
  },
  "buffer_line_height": "comfortable",
  "ui_font_family": "Monaspace Neon",
  "ui_font_size": 15.0,
  "soft_wrap": "none",
  "hard_tabs": false,
  "cursor_shape": "bar",
  "show_whitespaces": "selection",
  "allow_rewrap": "in_comments",
  "relative_line_numbers": "enabled",
  "snippet_sort_order": "top",
  "gutter": {
    "min_line_number_digits": 1,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "centered_layout": {
    "left_padding": 0.12,
    "right_padding": 0.12,
  },
  "tab_bar": {
    "show": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "minimap": {
    "show": "never",
  },
  "indent_guides": {
    "enabled": false,
  },
  "show_wrap_guides": false,
  "show_edit_predictions": false,
  "show_call_status_icon": false,
  "inline_code_actions": false,
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "file_icons": true,
  },
  "status_bar": {
    "active_encoding_button": "enabled",
    "active_language_button": true,
  },
  "project_panel": {
    "dock": "left",
    "button": false,
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "bottom_dock_layout": "full",
  "git": {
    "enable_diff": true,
    "enable_status": true,
    "disable_git": false,
    "path_style": "file_name_first",
    "hunk_style": "staged_hollow",
    "branch_picker": {
      "show_author_name": true,
    },
    "blame": {
      "show_avatar": true,
    },
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": false,
    },
  },
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "experimental.theme_overrides": {
    "vim.normal.background": "#8aadf4",
    "vim.insert.background": "#a6da95",
    "vim.visual.background": "#c6a0f6",
    "vim.replace.background": "#ed8796",
    "vim.visual_line.background": "#f5bde6",
  },
  "base_keymap": "VSCode",
  "use_system_window_tabs": true,
  "session": {
    "trust_all_worktrees": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": true,
    },
  },
  "text_rendering_mode": "platform_default",
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "opencode",
      "model": "zen/claude-sonnet-4-6",
      "enable_thinking": false,
    },
    "inline_assistant_model": {
      "provider": "opencode",
      "model": "zen/claude-sonnet-4-6",
      "enable_thinking": false,
    },
    "tool_permissions": {
      "tools": {
        "delete_path": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^/Users/orlandoromo/go/src/omg/storefront\\-app/backend/routes/checkout/",
            },
          ],
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^cd\\s+/Users/orlandoromo/go/src/omg/teamdealeronline/apps/api/modules/orders/actions(\\s|$)",
            },
            { "pattern": "^grep\\b" },
            { "pattern": "^git\\s+restore(\\s|$)" },
          ],
        },
      },
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": { "type": "registry" },
    "cursor": { "type": "registry" },
    "OpenCode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
    },
  },
  "languages": {
    "PHP": {
      "show_edit_predictions": true,
      "language_servers": ["intelephense"],
      "formatter": "prettier",
      "format_on_save": "off",
    },
    "C": {
      "format_on_save": "on",
      "tab_size": 2,
      "show_edit_predictions": true,
    },
  },
}
