// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "default_model": {
      "provider": "opencode",
      "model": "zen/claude-sonnet-5",
      "enable_thinking": true,
      "effort": "max"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "terminal": {
    "font_size": 12.0,
    "dock": "bottom"
  },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": true,
    "sticky_scroll": false,
    "indent_guides": {
      "show": "never"
    }
  },
  "file_finder": {
    "modal_max_width": "large"
  },
  "bottom_dock_layout": "full",
  "icon_theme": {
    "mode": "light",
    "light": "Warm Charmed Icons",
    "dark": "Zed (Default)"
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "vim_mode": true,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Base16 Oxocarbon Dark"
  },
  "show_edit_predictions": true,
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "file_icons": false
  },
  "title_bar": {
    "show_branch_status_icon": false,
    "show_onboarding_banner": false,
    "show_menus": false,
    "show_user_picture": false,
    "show_user_menu": false
  },
  "status_bar": {
    "active_encoding_button": "enabled",
    "active_language_button": false,
    "cursor_position_button": false,
    "experimental.show": false
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "show": "never"
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "indent_guides": {
    "enabled": false
  },
  "cursor_blink": false,
  "show_whitespaces": "none",
  "current_line_highlight": "gutter",
  "lsp_document_colors": "background",
  "seed_search_query_from_cursor": "selection",
  "use_smartcase_search": true,
  "scroll_beyond_last_line": "off",
  "active_pane_modifiers": {
    "inactive_opacity": 0.75,
    "border_size": 0.0
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false
  },
  "buffer_font_family": "Departure Mono",
  "ui_font_family": "Departure Mono",
  "languages": {
    "PHP": {
      "show_edit_predictions": true,
      "language_servers": ["intelephense"],
      "formatter": "prettier",
      "format_on_save": "off"
    },
    "C": {
      "format_on_save": "on",
      "tab_size": 2,
      "show_edit_predictions": true
    },
    "JSON": {
      "format_on_save": "on",
      "tab_size": 2
    }
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "experimental.theme_overrides": {
    "vim.normal.background": "#3e8fb0",
    "vim.insert.background": "#9ccfd8",
    "vim.visual.background": "#c4a7e7",
    "vim.replace.background": "#eb6f92",
    "vim.visual_line.background": "#c4a7e7"
  },
  "format_on_save": "on",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]"
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "OpenCode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  },
  "theme_overrides": {
    "Aura Dark": {
      "border.variant": "#15141C",
      "border": "#15141C",
      "title_bar.background": "#15141C",
      "panel.background": "#15141C",
      "panel.focused_border": "#4E466E",
      "players": [
        {
          "cursor": "#BD9DFF"
        }
      ]
    },
    "Panda Nebula": {
      "border.variant": "#1e1e32",
      "border": "#1e1e32",
      "title_bar.background": "#1e1e32",
      "panel.background": "#1e1e32",
      "panel.focused_border": "#1e1e32",
      "players": [
        {
          "cursor": "#ffffff"
        }
      ]
    }
  }
}
