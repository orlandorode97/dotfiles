# ── Ghostty · minimal terminal · Oxocarbon ────────────────────
# Reload: ⌘⇧,

# ── Typography ───────────────────────────────────────────────
# font-family = "Monaspace Neon"
font-family = "Departure Mono"
font-size = 14
font-thicken = true
font-feature = +liga
font-feature = +calt
adjust-cell-height = 8%

# ── Colors ───────────────────────────────────────────────────
# Oxocarbon · bg #161616 / fg #f2f4f8
theme = Oxocarbon
selection-background = #393939
selection-foreground = #f2f4f8
cursor-color = #ffffff
cursor-text = #161616
cursor-style = bar
cursor-style-blink = false

# ── Window ───────────────────────────────────────────────────
background-opacity = 1.0
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-vsync = true
window-decoration = none
window-new-tab-position = end

# ── Chrome (invisible) ───────────────────────────────────────
window-decoration = none
macos-window-shadow = false
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
window-new-tab-position = end
confirm-close-surface = false

# ── Splits ───────────────────────────────────────────────────
unfocused-split-opacity = 1
split-divider-color = #393939

# ── Behavior ─────────────────────────────────────────────────
shell-integration = none
mouse-hide-while-typing = true
bell-features = no-attention,no-system

# ── Keybindings ──────────────────────────────────────────────
keybind = cmd+t=new_tab
keybind = cmd+d=new_split:down
keybind = cmd+e=new_split:right
