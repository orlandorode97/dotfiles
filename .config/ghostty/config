font-family = "Monaspace Neon"
font-size = 14

theme = Chalkboard

shell-integration = none
shell-integration-feature = path
confirm-close-surface = false

# Window
window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
window-vsync = true
window-decoration = none
window-new-tab-position = end

# macOS
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
macos-window-shadow = false
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = bdbdbd
macos-icon-screen-color = 4d4d4d

# Background
background-opacity = 0.85
background-blur-radius = 40

# Splits
unfocused-split-opacity = 1

# Keybinds - splits
keybind = cmd+d=new_split:down
keybind = cmd+e=new_split:right

# Keybinds - tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+shift+[=previous_tab
